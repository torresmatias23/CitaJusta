generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING  @map("PENDIENTE")
  ACTIVE   @map("ACTIVO")
  INACTIVE @map("INACTIVO")
  BLOCKED  @map("BLOQUEADO")

  @@map("estado_usuario")
}

enum RoleScope {
  GLOBAL      @map("GLOBAL")
  INSTITUTION @map("INSTITUCION")
  BRANCH      @map("SEDE")

  @@map("alcance_rol")
}

enum InstitutionStatus {
  ACTIVE    @map("ACTIVA")
  INACTIVE  @map("INACTIVA")
  SUSPENDED @map("SUSPENDIDA")

  @@map("estado_institucion")
}

enum BranchStatus {
  ACTIVE   @map("ACTIVA")
  INACTIVE @map("INACTIVA")

  @@map("estado_sede")
}

enum ProfessionalStatus {
  ACTIVE    @map("ACTIVO")
  INACTIVE  @map("INACTIVO")
  SUSPENDED @map("SUSPENDIDO")

  @@map("estado_profesional")
}

enum AvailabilityOrigin {
  BASE_SCHEDULE @map("HORARIO_BASE")
  EXCEPTION     @map("EXCEPCION")
  MANUAL        @map("MANUAL")

  @@map("origen_disponibilidad")
}

enum ScheduleBlockType {
  VACATION    @map("VACACIONES")
  LEAVE       @map("LICENCIA")
  MEETING     @map("REUNION")
  MAINTENANCE @map("MANTENCION")
  MANUAL      @map("MANUAL")
  OTHER       @map("OTRO")

  @@map("tipo_bloqueo_agenda")
}

enum SlotStatus {
  AVAILABLE @map("DISPONIBLE")
  RESERVED  @map("RESERVADO")
  BLOCKED   @map("BLOQUEADO")
  RELEASED  @map("LIBERADO")
  EXPIRED   @map("EXPIRADO")

  @@map("estado_cupo")
}

model User {
  id                      String      @id @db.Uuid
  email                   String      @unique @db.VarChar(254)
  passwordHash            String      @map("password_hash") @db.VarChar(255)
  firstNames              String      @map("nombres") @db.VarChar(120)
  lastNames               String      @map("apellidos") @db.VarChar(120)
  phone                   String?     @map("telefono") @db.VarChar(30)
  nationalIdentifier      String?     @unique @map("rut") @db.VarChar(20)
  status                  UserStatus  @default(PENDING) @map("estado")
  emailVerifiedAt         DateTime?   @map("email_verificado_at") @db.Timestamp(6)
  lastLoginAt             DateTime?   @map("ultimo_login_at") @db.Timestamp(6)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt               DateTime?   @map("deleted_at") @db.Timestamp(6)
  roleAssignments         UserRole[]  @relation("UserRoleUser")
  assignedRoleAssignments UserRole[]  @relation("UserRoleAssignedBy")
  professionalProfiles    Professional[]
  createdScheduleBlocks   ScheduleBlock[]

  @@index([status])
  @@index([lastNames, firstNames])
  @@map("usuarios")
}

model Role {
  id              String           @id @db.Uuid
  code            String           @unique @map("codigo") @db.VarChar(80)
  name            String           @map("nombre") @db.VarChar(120)
  description     String?          @map("descripcion") @db.Text
  scope           RoleScope        @map("alcance")
  isSystem        Boolean          @default(false) @map("es_sistema")
  active          Boolean          @default(true) @map("activo")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  userAssignments UserRole[]
  permissions     RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique @map("codigo") @db.VarChar(120)
  module      String           @map("modulo") @db.VarChar(80)
  action      String           @map("accion") @db.VarChar(80)
  description String?          @map("descripcion") @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permisos")
}

model Institution {
  id                String            @id @db.Uuid
  name              String            @map("nombre") @db.VarChar(180)
  legalName         String?           @map("nombre_legal") @db.VarChar(220)
  taxIdentifier     String?           @unique @map("identificador_tributario") @db.VarChar(30)
  contactEmail      String?           @map("email_contacto") @db.VarChar(254)
  phone             String?           @map("telefono") @db.VarChar(30)
  timeZone          String            @default("America/Santiago") @map("zona_horaria") @db.VarChar(80)
  status            InstitutionStatus @default(ACTIVE) @map("estado")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamp(6)
  branches          Branch[]
  roleAssignments   UserRole[]
  serviceCategories ServiceCategory[]
  services          Service[]
  professionals     Professional[]
  scheduleBlocks    ScheduleBlock[]
  holidays          Holiday[]

  @@index([name])
  @@map("instituciones")
}

model Branch {
  id              String       @id @db.Uuid
  institutionId   String       @map("institucion_id") @db.Uuid
  code            String       @map("codigo") @db.VarChar(50)
  name            String       @map("nombre") @db.VarChar(160)
  addressLine1    String?      @map("direccion_linea1") @db.VarChar(220)
  addressLine2    String?      @map("direccion_linea2") @db.VarChar(220)
  municipality    String?      @map("comuna") @db.VarChar(120)
  region          String?      @db.VarChar(120)
  country         String       @default("Chile") @map("pais") @db.VarChar(80)
  latitude        Decimal?     @map("latitud") @db.Decimal(10, 7)
  longitude       Decimal?     @map("longitud") @db.Decimal(10, 7)
  phone           String?      @map("telefono") @db.VarChar(30)
  email           String?      @db.VarChar(254)
  status          BranchStatus @default(ACTIVE) @map("estado")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamp(6)
  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleAssignments UserRole[]
  serviceAssignments      ServiceBranch[]
  professionalAssignments ProfessionalBranch[]
  attentionPoints         AttentionPoint[]
  professionalSchedules   ProfessionalSchedule[]
  availabilities          Availability[]
  scheduleBlocks          ScheduleBlock[]
  holidays                Holiday[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([status])
  @@map("sedes")
}

model UserRole {
  id               String       @id @db.Uuid
  userId           String       @map("usuario_id") @db.Uuid
  roleId           String       @map("rol_id") @db.Uuid
  institutionId    String?      @map("institucion_id") @db.Uuid
  branchId         String?      @map("sede_id") @db.Uuid
  assignedByUserId String?      @map("asignado_por_usuario_id") @db.Uuid
  active           Boolean      @default(true) @map("activo")
  validFrom        DateTime?    @map("valid_from") @db.Timestamp(6)
  validTo          DateTime?    @map("valid_to") @db.Timestamp(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  user             User         @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role             Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institution      Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User?        @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([institutionId])
  @@index([branchId])
  @@map("usuarios_roles")
}

model RolePermission {
  roleId       String     @map("rol_id") @db.Uuid
  permissionId String     @map("permiso_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permisos")
}

model ServiceCategory {
  id            String   @id @db.Uuid
  institutionId String   @map("institucion_id") @db.Uuid
  name          String   @map("nombre") @db.VarChar(140)
  description   String?  @map("descripcion") @db.Text
  active        Boolean  @default(true) @map("activo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  services    Service[]

  @@unique([institutionId, name])
  @@map("categorias_servicio")
}

model Service {
  id                    String    @id @db.Uuid
  institutionId         String    @map("institucion_id") @db.Uuid
  categoryId            String?   @map("categoria_id") @db.Uuid
  code                  String    @map("codigo") @db.VarChar(50)
  name                  String    @map("nombre") @db.VarChar(180)
  description           String?   @map("descripcion") @db.Text
  durationMinutes       Int       @map("duracion_minutos")
  minimumAdvanceMinutes Int       @default(0) @map("anticipacion_minima_minutos")
  maximumAdvanceDays    Int?      @map("anticipacion_maxima_dias")
  allowsWaitlist        Boolean   @default(true) @map("permite_lista_espera")
  requiresConfirmation  Boolean   @default(false) @map("requiere_confirmacion")
  active                Boolean   @default(true) @map("activo")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamp(6)

  institution             Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category                ServiceCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branchAssignments       ServiceBranch[]
  requirements            ServiceRequirement[]
  professionalAssignments ProfessionalService[]
  availabilities          Availability[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([categoryId])
  @@index([active])
  @@map("servicios")
}

model ServiceBranch {
  serviceId String   @map("servicio_id") @db.Uuid
  branchId  String   @map("sede_id") @db.Uuid
  active    Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([serviceId, branchId])
  @@map("servicios_sedes")
}

model ServiceRequirement {
  id          String   @id @db.Uuid
  serviceId   String   @map("servicio_id") @db.Uuid
  name        String   @map("nombre") @db.VarChar(180)
  description String?  @map("descripcion") @db.Text
  required    Boolean  @default(false) @map("obligatorio")
  order       Int      @default(0) @map("orden")
  active      Boolean  @default(true) @map("activo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([serviceId])
  @@map("requisitos_servicio")
}

model Professional {
  id              String             @id @db.Uuid
  institutionId   String             @map("institucion_id") @db.Uuid
  userId          String             @map("usuario_id") @db.Uuid
  internalCode    String?            @map("codigo_interno") @db.VarChar(60)
  titleOrFunction String?            @map("titulo_o_funcion") @db.VarChar(160)
  description     String?            @map("descripcion") @db.Text
  status          ProfessionalStatus @default(ACTIVE) @map("estado")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamp(6)

  institution       Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceAssignments ProfessionalService[]
  branchAssignments  ProfessionalBranch[]
  schedules          ProfessionalSchedule[]
  availabilities     Availability[]
  scheduleBlocks     ScheduleBlock[]

  @@unique([institutionId, userId])
  @@unique([institutionId, internalCode])
  @@index([status])
  @@map("profesionales")
}

model ProfessionalService {
  professionalId        String   @map("profesional_id") @db.Uuid
  serviceId             String   @map("servicio_id") @db.Uuid
  customDurationMinutes Int?     @map("duracion_personalizada_minutos")
  active                Boolean  @default(true) @map("activo")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([professionalId, serviceId])
  @@map("profesionales_servicios")
}

model ProfessionalBranch {
  professionalId String   @map("profesional_id") @db.Uuid
  branchId       String   @map("sede_id") @db.Uuid
  active         Boolean  @default(true) @map("activo")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([professionalId, branchId])
  @@map("profesionales_sedes")
}

model AttentionPoint {
  id          String   @id @db.Uuid
  branchId    String   @map("sede_id") @db.Uuid
  code        String   @map("codigo") @db.VarChar(50)
  name        String   @map("nombre") @db.VarChar(120)
  capacity    Int      @default(1) @map("capacidad")
  description String?  @map("descripcion") @db.Text
  active      Boolean  @default(true) @map("activo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schedules     ProfessionalSchedule[]
  availabilities Availability[]
  scheduleBlocks ScheduleBlock[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("boxes_atencion")
}

model ProfessionalSchedule {
  id               String    @id @db.Uuid
  professionalId   String    @map("profesional_id") @db.Uuid
  branchId         String    @map("sede_id") @db.Uuid
  attentionPointId String?   @map("box_id") @db.Uuid
  dayOfWeek        Int       @map("dia_semana")
  startTime        DateTime  @map("hora_inicio") @db.Time(6)
  endTime          DateTime  @map("hora_fin") @db.Time(6)
  validFrom        DateTime  @map("valido_desde") @db.Date
  validUntil       DateTime? @map("valido_hasta") @db.Date
  active           Boolean   @default(true) @map("activo")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  professional  Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attentionPoint AttentionPoint? @relation(fields: [attentionPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([professionalId])
  @@index([branchId])
  @@index([professionalId, branchId, dayOfWeek])
  @@map("horarios_profesional")
}

model Availability {
  id               String             @id @db.Uuid
  professionalId   String             @map("profesional_id") @db.Uuid
  serviceId        String             @map("servicio_id") @db.Uuid
  branchId         String             @map("sede_id") @db.Uuid
  attentionPointId String?            @map("box_id") @db.Uuid
  date             DateTime           @map("fecha") @db.Date
  startTime        DateTime           @map("hora_inicio") @db.Time(6)
  endTime          DateTime           @map("hora_fin") @db.Time(6)
  origin           AvailabilityOrigin @default(BASE_SCHEDULE) @map("origen")
  capacity         Int                @default(1) @map("capacidad")
  active           Boolean            @default(true) @map("activo")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attentionPoint AttentionPoint? @relation(fields: [attentionPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slots          AgendaSlot[]

  @@unique([professionalId, date, startTime, endTime])
  @@index([professionalId])
  @@index([serviceId])
  @@index([branchId])
  @@index([date])
  @@map("disponibilidades")
}

model ScheduleBlock {
  id                String            @id @db.Uuid
  institutionId     String            @map("institucion_id") @db.Uuid
  branchId          String?           @map("sede_id") @db.Uuid
  professionalId    String?           @map("profesional_id") @db.Uuid
  attentionPointId  String?           @map("box_id") @db.Uuid
  type              ScheduleBlockType @map("tipo")
  startsAt          DateTime          @map("inicio_at") @db.Timestamp(6)
  endsAt            DateTime          @map("fin_at") @db.Timestamp(6)
  reason            String?           @map("motivo") @db.Text
  createdByUserId   String            @map("creado_por_usuario_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional  Professional?  @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attentionPoint AttentionPoint? @relation(fields: [attentionPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([institutionId])
  @@index([branchId])
  @@index([professionalId])
  @@index([startsAt, endsAt])
  @@map("bloqueos_agenda")
}

model Holiday {
  id              String    @id @db.Uuid
  institutionId   String    @map("institucion_id") @db.Uuid
  branchId        String?   @map("sede_id") @db.Uuid
  date            DateTime  @map("fecha") @db.Date
  name            String    @map("nombre") @db.VarChar(180)
  blocksEntireDay Boolean   @default(true) @map("bloquea_todo_el_dia")
  startTime       DateTime? @map("hora_inicio") @db.Time(6)
  endTime         DateTime? @map("hora_fin") @db.Time(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([institutionId, branchId, date, name])
  @@index([date])
  @@map("feriados")
}

model AgendaSlot {
  id             String     @id @db.Uuid
  availabilityId String     @map("disponibilidad_id") @db.Uuid
  startsAt       DateTime   @map("inicio_at") @db.Timestamp(6)
  endsAt         DateTime   @map("fin_at") @db.Timestamp(6)
  status         SlotStatus @default(AVAILABLE) @map("estado")
  blockedUntilAt DateTime?  @map("bloqueado_hasta_at") @db.Timestamp(6)
  lockVersion    Int        @default(0) @map("version_lock")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([availabilityId, startsAt, endsAt])
  @@index([status])
  @@index([startsAt])
  @@map("cupos_agenda")
}
