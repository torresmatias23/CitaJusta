NODE_ENV=development
PORT=3000
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CALENDAR_ENABLED=false
# Backend only; popup exchange uses the exact Web origin, not a callback path.
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:5173
EMAIL_DELIVERY_ENABLED=false
# RF-003 is opt-in; configure all keys locally before enabling.
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_RECOVERY_WEB_ORIGIN=http://127.0.0.1:5173
ACCOUNT_RECOVERY_KEY_ID=recovery-v1
# Independent random 32-byte hexadecimal keys; never use JWT secrets here.
ACCOUNT_RECOVERY_ENCRYPTION_KEY=
ACCOUNT_RECOVERY_HMAC_KEY=
ACCOUNT_RECOVERY_TTL_MINUTES=30
ACCOUNT_RECOVERY_WINDOW_MINUTES=60
ACCOUNT_RECOVERY_MAX_REQUESTS=3
ACCOUNT_RECOVERY_MIN_INTERVAL_SECONDS=60
EMAIL_DELIVERY_INTERVAL_MS=30000
EMAIL_DELIVERY_BATCH_SIZE=10
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_REQUEST_TIMEOUT_MS=10000
EMAIL_DELIVERY_LEASE_MS=60000
# Only required when enabled; configure locally, never commit real credentials.
RESEND_API_KEY=re_REPLACE_WITH_SENDING_KEY
RESEND_FROM=CitaJusta <sender@example.test>
WAITLIST_OFFER_TTL_MINUTES=10
OFFER_EXPIRATION_ENABLED=true
OFFER_EXPIRATION_INTERVAL_MS=30000
OFFER_EXPIRATION_BATCH_SIZE=50
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_SHADOW
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
