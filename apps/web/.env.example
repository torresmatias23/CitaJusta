# Desarrollo local: copiar esta plantilla a apps/web/.env y reiniciar Vite.
# Configuración pública: nunca incluir secretos ni tokens en variables VITE_*.
VITE_API_BASE_URL=/api/v1
# Optional public Web client ID; leave empty to keep only local login.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CALENDAR_ENABLED=false
# Obligatorio para Vite dev; build/producción no usan este proxy.
API_PROXY_TARGET=http://localhost:3000
