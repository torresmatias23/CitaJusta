# Variables de docker-compose.yml. Copiar a .env (ignorado por Git) y completar.
# Para desarrollo sin Docker, usar apps/api/.env.example y apps/web/.env.example.

# PostgreSQL del contenedor. Usar una contraseña sin caracteres especiales de URL (@ : / ? #).
POSTGRES_USER=citajusta
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

# Secretos JWT: al menos 32 caracteres y distintos entre sí.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Puertos publicados en el host.
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# Integraciones opcionales (deshabilitadas por defecto).
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080
