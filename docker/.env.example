# Copy to docker/.env (ignored by Git). Never use production credentials.
# Fill each required value with a DIFFERENT random 64-character hexadecimal value.
# Empty required values make Compose fail before starting any service.
DOCKER_DB_PASSWORD=
DOCKER_JWT_ACCESS_SECRET=
DOCKER_JWT_REFRESH_SECRET=

# Published ONLY on host loopback. PostgreSQL is not published.
DOCKER_API_PORT=3000
DOCKER_WEB_PORT=8080
